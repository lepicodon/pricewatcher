# PriceWatcher secrets and runtime environment overrides
# Copy to .env before running Docker Compose or local tests.

# --- Authentication & Web Security ---
# Admin password hash (generate with: pricewatcher hash-password).
# Outputs colon-delimited scrypt:16384:8:1:<salt>:<digest> (safe in .env without quoting).
PRICEWATCHER_ADMIN_PASSWORD_HASH=

# Secret used to sign admin session cookies (generate with: openssl rand -hex 32).
PRICEWATCHER_SESSION_SECRET=

# Local development ONLY: set to "1" to bypass login checks.
# Leave empty/unset in production so admin routes fail closed.
PRICEWATCHER_INSECURE_NO_AUTH=

# Set to "1" to always mark session/CSRF cookies with the Secure attribute
# (enabled automatically when requests arrive over HTTPS or X-Forwarded-Proto: https).
PRICEWATCHER_COOKIE_SECURE=

# Comma-separated trusted reverse proxy IPs/CIDRs (e.g. Traefik subnet 172.18.0.0/16) for X-Forwarded-For
PRICEWATCHER_TRUSTED_PROXIES=

# --- Network & SSRF Protections ---
# Optional comma-separated list of private hosts/IPs permitted past the SSRF guard.
PRICEWATCHER_ALLOW_PRIVATE_HOSTS=

# Contact URL included in the Reddit User-Agent header.
PRICEWATCHER_CONTACT_URL=https://github.com/your-username/pricewatcher

# Maximum HTTP response body size in bytes (default: 5242880 = 5 MiB).
PRICEWATCHER_MAX_RESPONSE_BYTES=5242880

# --- Notifications (WAHA & SMTP) ---
# WAHA gateway URL (behind Traefik on NAS; override to LAN/localhost for Mac tests)
WAHA_URL=http://waha.docker
WAHA_API_KEY=replace_with_your_waha_api_key
# Optional WAHA session override (defaults to notifications.waha.session in config/settings.yaml)
# WAHA_SESSION=pricewatcher

# Optional SMTP fallback credentials
SMTP_USER=
SMTP_PASS=

# --- Runtime & Build Options ---
TZ=America/New_York
LOG_LEVEL=INFO
# INSTALL_PLAYWRIGHT=false

# Optional runtime paths (set automatically inside Docker; leave commented for local Mac runs)
# PRICEWATCHER_DB_PATH=/data/prices.db
# PRICEWATCHER_CONFIG_DIR=/app/config
